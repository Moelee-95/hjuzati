	function insertPhotoToDb($file_name,$hotel_id){
		$addToDb = "";
		include ('db_connect.php');
		if ($conn->connect_error) {
		echo "Something is wrong with connection to the database";}
		else {
			$select = "SELECT photos FROM photos WHERE hotel_id = $hotel_id";
			$select_query = mysqli_query($conn,$select);
			$fetch = mysqli_fetch_array($select_query);
			//echo $fetch['0']."<br>";
			$previus_data =$fetch['0'];
			//to check the files one by one
			$previus_data_arr =explode('***', $previus_data);
			//if the file name is already exsist assign no to the variable $addToDb
			foreach ($previus_data_arr as $key => $p_data_str) {
				if ($p_data_str == $file_name) {
					$addToDb = "no";
				}
			}
			if ($addToDb != "no") {
				$new_data = $previus_data."***".$file_name;
				//Remove first extra ,,, from String
				$new_data = ltrim($new_data,'***');
				//Remove Last extra ,,, from string
				$new_data = rtrim($new_data,'***');

				$sql = "UPDATE photos SET photos = '$new_data' WHERE hotel_id = '$hotel_id'";
				$query = mysqli_query($conn, $sql);
				if ($query) {
					echo "Image has been saved to the database succesfully!";
				}
				else {
					echo "Image hasn't been added to the database because it's already added!";
				}
			}#duplicated names in database
			
		}#connection else

	}#function




			

